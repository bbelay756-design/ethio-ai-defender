# Application Configuration
APP_NAME="ETHIO-AI Defender"
APP_ENV=development
DEBUG=True
HOST=127.0.0.1
PORT=8000

# Security & Storage Limits
# Max upload size in bytes (Default: 52428800 = 50 MB)
MAX_FILE_SIZE_BYTES=52428800
# Max raw multipart request body for upload endpoints, in bytes. Should be a
# little larger than MAX_FILE_SIZE_BYTES to allow for multipart framing overhead.
# Enforced before multipart parsing. (Default: 53477376 = 51 MB)
MAX_UPLOAD_BODY_BYTES=53477376
# Chunk size (bytes) used when streaming an uploaded file through the bounded reader.
UPLOAD_CHUNK_SIZE=1048576
STORAGE_BASE_DIR="storage"
UPLOAD_DIR="storage/uploads"
QUARANTINE_DIR="storage/quarantine"

# Cross-Origin Resource Sharing (CORS)
# Explicit comma-separated allowlist of trusted front-end origins. Leave EMPTY
# for the default same-origin deployment (recommended; disables cross-origin
# access entirely). Wildcards ('*') are rejected at startup.
# Example: CORS_ORIGINS=https://soc.ethio.example
CORS_ORIGINS=
# Only meaningful when CORS_ORIGINS is non-empty. Keep false unless required.
CORS_ALLOW_CREDENTIALS=false

# Logging Level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO
LOG_FILE="storage/logs/defender.log"

# Authentication & Token Signing (REQUIRED)
# SECRET_KEY signs access tokens and MUST be set to a strong, unique value of at
# least 32 characters. The platform refuses to start if it is missing or weak.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
# Comma-separated roles allowed to self-register publicly (ADMIN is never allowed).
SELF_REGISTRATION_ROLES=VIEWER
# Access token lifetime in minutes.
ACCESS_TOKEN_EXPIRE_MINUTES=60

# AI Service Configuration (Optional placeholder for future modules)
AI_PROVIDER=none
AI_API_KEY=

# Ghidra Headless Reverse-Engineering (Optional)
# Set GHIDRA_HOME to your extracted Ghidra installation directory, e.g. C:\ghidra_11.1_PUBLIC
# Leave empty to disable Ghidra (the platform degrades gracefully and reports it as unavailable).
GHIDRA_HOME=
GHIDRA_ENABLED=true
GHIDRA_TIMEOUT_SECONDS=300
GHIDRA_MAX_FUNCTIONS=2000
GHIDRA_KEEP_WORKSPACE=false
