# Application Configuration
APP_NAME="ETHIO-AI Defender"
APP_ENV=development
DEBUG=True
HOST=127.0.0.1
PORT=8000

# Security & Storage Limits
# Max upload size in bytes (Default: 52428800 = 50 MB)
MAX_FILE_SIZE_BYTES=52428800
STORAGE_BASE_DIR="storage"
UPLOAD_DIR="storage/uploads"
QUARANTINE_DIR="storage/quarantine"

# Logging Level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO
LOG_FILE="storage/logs/defender.log"

# Authentication & Token Signing (REQUIRED)
# SECRET_KEY signs access tokens and MUST be set to a strong, unique value of at
# least 32 characters. The platform refuses to start if it is missing or weak.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
# Comma-separated roles allowed to self-register publicly (ADMIN is never allowed).
SELF_REGISTRATION_ROLES=STUDENT
# Access token lifetime in minutes.
ACCESS_TOKEN_EXPIRE_MINUTES=60

# AI Service Configuration (Optional placeholder for future modules)
AI_PROVIDER=none
AI_API_KEY=

# Ghidra Headless Reverse-Engineering (Optional)
# Set GHIDRA_HOME to your extracted Ghidra installation directory, e.g. C:\ghidra_11.1_PUBLIC
# Leave empty to disable Ghidra (the platform degrades gracefully and reports it as unavailable).
GHIDRA_HOME=
GHIDRA_ENABLED=true
GHIDRA_TIMEOUT_SECONDS=300
GHIDRA_MAX_FUNCTIONS=2000
GHIDRA_KEEP_WORKSPACE=false
