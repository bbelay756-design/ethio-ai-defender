# Application Configuration
APP_NAME="ETHIO-AI Defender"
APP_ENV=development
DEBUG=True
HOST=127.0.0.1
PORT=8000

# Security & Storage Limits
# Max upload size in bytes (Default: 52428800 = 50 MB)
MAX_FILE_SIZE_BYTES=52428800
STORAGE_BASE_DIR="storage"
UPLOAD_DIR="storage/uploads"
QUARANTINE_DIR="storage/quarantine"

# Logging Level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO
LOG_FILE="storage/logs/defender.log"

# AI Service Configuration (Optional placeholder for future modules)
AI_PROVIDER=none
AI_API_KEY=
